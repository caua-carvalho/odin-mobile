# ODIN V2 Mobile — Environment Configuration
# Copy to .env only if you need to override the API host.
#
# The app auto-detects the backend host from the Expo/Metro hostUri (port 8000)
# when this variable is absent or points at localhost/127.0.0.1. For Expo Go on
# a physical device, start the backend with --host 0.0.0.0.
#
# Examples:
#   iOS simulator:      http://127.0.0.1:8000/api
#   Android emulator:   http://10.0.2.2:8000/api
#   Physical device:    http://192.168.x.x:8000/api
#   Tunnel / HTTPS:     https://your-host.example.com/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api